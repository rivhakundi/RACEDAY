@model ResultEntryViewModel
@{ ViewData["Title"] = "Enter race result"; }
<div class="form-page"><a asp-action="Enrolments" asp-route-id="@ViewBag.EventId" class="back-link">← Back to enrolments</a><div class="surface-card mt-3"><span class="eyebrow">OFFICIAL TIMING</span><h1 class="section-title">Enter race result</h1><p class="text-muted">Record a participant's finishing position and time.</p><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input type="hidden" name="eventId" value="@ViewBag.EventId"/><div class="mb-3"><label asp-for="EnrolmentId" class="form-label">Enrolment ID</label><input asp-for="EnrolmentId" class="form-control"/><span asp-validation-for="EnrolmentId" class="text-danger"></span></div><div class="mb-3"><label asp-for="Position" class="form-label">Finishing position</label><input asp-for="Position" class="form-control"/><span asp-validation-for="Position" class="text-danger"></span></div><div class="mb-4"><label asp-for="FinishTime" class="form-label">Finish time (HH:mm:ss)</label><input asp-for="FinishTime" class="form-control"/><span asp-validation-for="FinishTime" class="text-danger"></span></div><button class="btn btn-lime">Save result</button></form></div></div>
