@{ ViewData["Title"] = "Event enrolments"; var items = ViewBag.Enrolments as List<System.Text.Json.JsonElement> ?? new(); var ev = ViewBag.Event as EventViewModel; }
<a asp-action="Index" class="back-link">← Dashboard</a><div class="page-heading mt-3"><span class="eyebrow">PARTICIPANT ROSTER</span><h1 class="section-title">@(ev?.Name ?? "Event enrolments")</h1><p class="text-muted">Review registered participants and enter race results.</p></div><div class="surface-card mt-4"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Enrolment ID</th><th>Participant</th><th>Email</th><th>Category</th><th>Enrolled</th><th>Result</th></tr></thead><tbody>@foreach(var x in items){string val(string k)=>x.ValueKind==System.Text.Json.JsonValueKind.Object&&x.TryGetProperty(k,out var v)?v.ToString():"—"; int.TryParse(val("id"), out var enrolmentId); <tr><td>@val("id")</td><td>@val("username")</td><td>@val("email")</td><td>@val("categoryName")</td><td>@(DateTime.TryParse(val("registrationDate"),out var d)?d.ToString("dd MMM yyyy"):"—")</td><td><a class="btn btn-sm btn-outline-darkgreen" asp-action="Results" asp-route-id="@ViewBag.EventId" asp-route-enrolmentId="@enrolmentId">Enter result</a></td></tr>}@if(!items.Any()){<tr><td colspan="6" class="text-center text-muted py-4">No enrolments returned by the API.</td></tr>}</tbody></table></div></div>
