@model EventViewModel
@{ ViewData["Title"] = "Edit event"; }
<div class="form-page"><a asp-action="Index" class="back-link">← Dashboard</a><div class="surface-card mt-3"><span class="eyebrow">UPDATE YOUR RACE</span><h1 class="section-title">Edit event</h1><form method="post" enctype="multipart/form-data"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="col-md-6"><label asp-for="Date" class="form-label"></label><input asp-for="Date" type="datetime-local" class="form-control"/></div><div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-4"><label asp-for="Distance" class="form-label"></label><input asp-for="Distance" class="form-control"/></div><div class="col-md-8"><label for="banner" class="form-label">Replace event banner (optional)</label><input id="banner" name="banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp"/></div></div><button class="btn btn-lime mt-4">Save changes</button></form></div></div>
