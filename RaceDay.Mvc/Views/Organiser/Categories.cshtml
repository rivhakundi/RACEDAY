@model CategoryViewModel
@{ ViewData["Title"] = "Manage categories"; var ev = ViewBag.Event as EventViewModel; var cats = ViewBag.Categories as List<CategoryViewModel> ?? new(); }
<a asp-action="Index" class="back-link">← Dashboard</a><div class="page-heading mt-3"><span class="eyebrow">RACE DIVISIONS</span><h1 class="section-title">Categories</h1><p class="text-muted">@(ev?.Name ?? "Event") · Add age groups or distance categories.</p></div><div class="row g-4 mt-1"><div class="col-lg-5"><div class="surface-card"><h2 class="h5 fw-bold">Add a category</h2><form asp-action="AddCategory" method="post"><input asp-for="EventId" type="hidden"/><div class="mb-3"><label asp-for="Name" class="form-label">Category name</label><input asp-for="Name" class="form-control" placeholder="e.g. Open Women, Under 18" required/><span asp-validation-for="Name" class="text-danger"></span></div><button class="btn btn-lime">Add category</button></form></div></div><div class="col-lg-7"><div class="surface-card"><h2 class="h5 fw-bold">Available categories</h2>@if(cats.Any()){@foreach(var c in cats){<div class="d-flex justify-content-between align-items-center border-bottom py-3"><span>@c.Name</span><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.Id"/><input type="hidden" name="eventId" value="@c.EventId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div>}}else{<p class="text-muted mb-0">No categories have been added yet.</p>}</div></div></div>
