@{ ViewData["Title"] = "Participant home"; var events = ViewBag.Events as List<EventViewModel> ?? new(); }
<section class="participant-hero"><span class="eyebrow">YOUR NEXT PERSONAL BEST</span><h1 class="section-title">Good to have you here, @Context.Session.GetString("Username").</h1><p>Every kilometre counts. Find your next challenge and get race-ready.</p><a class="btn btn-lime" asp-controller="Home" asp-action="Index">Browse all events →</a></section><div class="d-flex justify-content-between align-items-end mt-5 mb-3"><h2 class="h3 fw-bold">Coming up next</h2><a asp-controller="Home" asp-action="Index">View all events</a></div><div class="row g-3">@foreach(var e in events){<div class="col-md-6 col-xl-3"><div class="mini-event"><span class="event-date">@e.Date.ToString("dd MMM yyyy")</span><h3 class="h5 mt-2">@e.Name</h3><p class="text-muted small">@e.Location · @e.Distance km</p><a asp-controller="Events" asp-action="Details" asp-route-id="@e.Id" class="btn btn-outline-darkgreen btn-sm">Event details</a></div></div>}@if(!events.Any()){<p class="text-muted">No upcoming events are available at the moment.</p>}</div><div class="row g-3 mt-4"><div class="col-md-6"><a class="quick-link" asp-action="MyEvents"><span>📅</span><div><strong>My events</strong><small>Review your enrolments and status.</small></div><b>→</b></a></div><div class="col-md-6"><a class="quick-link" asp-action="MyResults"><span>🏆</span><div><strong>My results</strong><small>See your race history and finish times.</small></div><b>→</b></a></div></div>
