@model List<EventViewModel>
@{ ViewData["Title"] = "Discover events"; }
<section class="hero mb-5"><div class="hero-copy"><span class="eyebrow">YOUR NEXT CHALLENGE STARTS HERE</span><h1>Find your pace.<br/><span>Own your finish.</span></h1><p>Discover local races, sign up in minutes, and make your next finish line count.</p><a class="btn btn-lime btn-lg" href="#events">Explore upcoming events <span aria-hidden="true">→</span></a></div><div class="hero-badge"><div class="badge-ring">RUN<br/><b>YOUR</b><br/>RACE</div></div></section>
<section id="events"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3"><div><span class="eyebrow">THE STARTING LINE</span><h2 class="section-title mb-0">Upcoming events</h2></div><span class="text-muted">@Model.Count event(s) found</span></div><form class="filter-bar row g-2 mb-4" method="get"><div class="col-md-6"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Search event or location..." aria-label="Search event or location"/></div><div class="col-md-3"><select class="form-select" name="type"><option value="">All event types</option>@foreach(var t in new[]{"Run","Walk","Cycle"}){<option selected="@(string.Equals((string?)ViewBag.Type,t,StringComparison.OrdinalIgnoreCase))" value="@t">@t</option>}</select></div><div class="col-md-3 d-grid"><button class="btn btn-darkgreen">Find events</button></div></form>
<div class="row g-4">@foreach(var e in Model){<div class="col-md-6 col-xl-4"><article class="event-card h-100"><div class="event-art"><span class="event-type">@e.EventType</span><span class="event-distance">@e.Distance km</span><div class="art-line"></div></div><div class="p-4"><div class="event-date">@e.Date.ToString("ddd, dd MMM yyyy")</div><h3 class="h5 fw-bold mt-2">@e.Name</h3><p class="text-muted mb-3">📍 @e.Location</p><p class="event-description">@e.Description</p><a class="btn btn-outline-darkgreen w-100 mt-2" asp-controller="Events" asp-action="Details" asp-route-id="@e.Id">View event <span aria-hidden="true">→</span></a></div></article></div>} @if(!Model.Any()){<div class="col-12"><div class="empty-state"><div class="empty-icon">🏁</div><h3>No upcoming events found</h3><p>Try another search or check back soon for new events.</p></div></div>}</div></section>
