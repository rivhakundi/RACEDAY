@model EventViewModel
@{ ViewData["Title"] = Model.Name; }
<a asp-controller="Home" asp-action="Index" class="back-link">← All events</a><div class="detail-hero mt-3">@if (!string.IsNullOrWhiteSpace(Model.BannerUrl)) { <img class="event-banner" src="@Model.BannerUrl" alt="Banner for @Model.Name"/> }<span class="event-type">@Model.EventType</span><span class="eyebrow d-block mt-4">RACEDAY EVENT</span><h1>@Model.Name</h1><p>@Model.Description</p><div class="detail-facts"><div><small>DATE</small><strong>@Model.Date.ToString("dd MMM yyyy")</strong></div><div><small>LOCATION</small><strong>@Model.Location</strong></div><div><small>DISTANCE</small><strong>@Model.Distance km</strong></div></div></div><div class="row g-4 mt-1"><div class="col-lg-7"><div class="surface-card"><h2 class="h4 fw-bold">Choose your category</h2><p class="text-muted">Select the category that best suits you.</p>@if(Model.Categories.Any()){<form asp-action="Enrol" method="post"><input type="hidden" name="EventId" value="@Model.Id"/><div class="mb-3"><label class="form-label" for="CategoryId">Available categories</label><select class="form-select" id="CategoryId" name="CategoryId" required><option value="">Select a category</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select></div>@if(Context.Session.GetString("Role")=="Participant"){<button class="btn btn-lime">Enrol now →</button>}else if(Context.Session.GetString("Role") is null){<a class="btn btn-darkgreen" asp-controller="Account" asp-action="Login">Log in to enrol</a>}</form>}else{<div class="alert alert-light">Categories have not been added to this event yet.</div>}</div></div><div class="col-lg-5"><div class="surface-card"><h2 class="h5 fw-bold">Before you go</h2><ul class="check-list"><li>Check your event date and location.</li><li>Choose the correct category before enrolling.</li><li>Keep an eye on your enrolment status.</li></ul></div></div></div>
