<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · RaceDay</title><link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body>
<nav class="navbar navbar-expand-lg navbar-dark rd-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RaceDay</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav me-auto mb-2 mb-lg-0"><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Explore events</a></li>
@if (Context.Session.GetString("Role") == "Organiser") { <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Create">Create event</a></li> }
@if (Context.Session.GetString("Role") == "Participant") { <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a></li><li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li> }
@if (Context.Session.GetString("Role") != null) { <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li> }
</ul><div class="d-flex gap-2 align-items-center">@if (Context.Session.GetString("Role") != null) { <span class="text-white-50 small d-none d-md-inline">Hi, @Context.Session.GetString("Username")</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Log out</button></form> } else { <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-lime btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a> }</div></div></div></nav>
<main class="container py-4">@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> } @if (TempData["Error"] != null) { <div class="alert alert-warning alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> } @RenderBody()</main>
<footer class="rd-footer"><div class="container d-flex flex-column flex-md-row justify-content-between gap-2"><span>© @DateTime.Now.Year RaceDay · Find your next finish line.</span><span>Move together. Go further.</span></div></footer><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
