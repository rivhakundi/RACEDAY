@{ ViewData["Title"] = "Organiser dashboard"; var events = ViewBag.Events as List<EventViewModel> ?? new(); }
<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">YOUR RACE HQ</span><h1 class="section-title">Organiser dashboard</h1><p class="text-muted mb-0">Keep your events on track from start to finish.</p></div><a class="btn btn-lime" asp-action="Create">＋ Create event</a></div><div class="row g-3 my-4"><div class="col-md-4"><div class="stat-card"><span>Events created</span><strong>@events.Count</strong><small>Across your event list</small></div></div><div class="col-md-4"><div class="stat-card"><span>Upcoming events</span><strong>@events.Count(e=>e.Date>=DateTime.Today)</strong><small>Ready for the starting line</small></div></div><div class="col-md-4"><div class="stat-card"><span>Next event</span><strong class="stat-date">@(events.Where(e=>e.Date>=DateTime.Today).OrderBy(e=>e.Date).FirstOrDefault()?.Date.ToString("dd MMM") ?? "—")</strong><small>Mark your calendar</small></div></div></div><div class="surface-card"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 fw-bold mb-0">Your events</h2><span class="text-muted small">@events.Count total</span></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Distance</th><th>Enrolments</th><th>Actions</th></tr></thead><tbody>@foreach(var e in events.OrderBy(e=>e.Date)){<tr><td><strong>@e.Name</strong><div class="small text-muted">@e.EventType</div></td><td>@e.Date.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.Distance km</td><td><span class="status-pill status-confirmed">@e.EnrolmentCount</span></td><td><div class="d-flex flex-wrap gap-1"><a class="btn btn-sm btn-outline-darkgreen" asp-action="Categories" asp-route-id="@e.Id">Categories</a><a class="btn btn-sm btn-outline-darkgreen" asp-action="Edit" asp-route-id="@e.Id">Edit</a><a class="btn btn-sm btn-outline-darkgreen" asp-action="Enrolments" asp-route-id="@e.Id">Enrolments</a><form asp-action="Delete" method="post" onsubmit="return confirm('Delete this event?')"><input type="hidden" name="id" value="@e.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>}@if(!events.Any()){<tr><td colspan="6" class="text-center text-muted py-4">No events yet. Create your first event to get started.</td></tr>}</tbody></table></div></div>
