@{ ViewData["Title"] = "My results"; var items = ViewBag.Items as List<System.Text.Json.JsonElement> ?? new(); }
<span class="eyebrow">EVERY FINISH TELLS A STORY</span><h1 class="section-title">My results</h1><p class="text-muted">Your personal race history and official results.</p><div class="surface-card mt-4"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var x in items){string val(string k)=>x.ValueKind==System.Text.Json.JsonValueKind.Object&&x.TryGetProperty(k,out var v)?v.ToString():"—";<tr><td><strong>@val("eventName")</strong></td><td>@val("eventDate")</td><td>@val("categoryName")</td><td>@val("finishTime")</td><td><span class="position-chip">#@val("position")</span><div class="small text-muted mt-1">of @val("finisherCount") finishers</div></td></tr>}@if(!items.Any()){<tr><td colspan="5" class="text-center text-muted py-4">Your published results will appear here after an Organiser records them.</td></tr>}</tbody></table></div></div>
