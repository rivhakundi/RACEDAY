@{ ViewData["Title"] = "My events"; var items = ViewBag.Items as List<System.Text.Json.JsonElement> ?? new(); }
<span class="eyebrow">YOUR RACE CALENDAR</span><h1 class="section-title">My events</h1><p class="text-muted">Your registered races and enrolment status.</p><div class="surface-card mt-4"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach(var x in items){string val(string k)=>x.ValueKind==System.Text.Json.JsonValueKind.Object&&x.TryGetProperty(k,out var v)?v.ToString():"—";var status=val("status");<tr><td>@val("eventName")</td><td>@val("eventDate")</td><td>@val("categoryName")</td><td><span class="status-pill @(status.Equals("Confirmed",StringComparison.OrdinalIgnoreCase)?"status-confirmed":"status-pending")">@(status=="—"?"Registered":status)</span></td></tr>}@if(!items.Any()){<tr><td colspan="4" class="text-center text-muted py-4">Your enrolled events will appear here.</td></tr>}</tbody></table></div></div>
